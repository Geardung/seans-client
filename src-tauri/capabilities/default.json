{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Seans main window (M1 shell: deep-link + window focus).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-set-title",
    "deep-link:default"
  ]
}
